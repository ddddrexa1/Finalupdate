// =========================================================
// STATUS
// =========================================================

function setStatus(
  message,
  type = "loading"
) {

  const box =
    $("systemStatus");

  const text =
    $("statusText");

  if (!box || !text) return;

  box.className =
    "system-status " + type;

  text.textContent =
    message;
}


function loading(message) {
  setStatus(message, "loading");
}


function online(message) {
  setStatus(message, "online");
}


function errorStatus(message) {
  setStatus(message, "error");
}


// =========================================================
// BUTTON LOCK
// =========================================================

function lockButtons(lock) {

  const buttons =
    document.querySelectorAll(
      ".game-btn"
    );


  buttons.forEach(button => {

    if (lock) {

      button.dataset.wasDisabled =
        button.disabled
          ? "yes"
          : "no";

      button.disabled = true;

    } else {

      if (
        button.dataset.wasDisabled !==
        "yes"
      ) {
        button.disabled = false;
      }
    }
  });
}


// =========================================================
// PLAYER ID
// =========================================================

function getPlayerId() {

  let id =
    sessionStorage.getItem(
      "mr_reaper_player_id"
    );


  if (!id) {

    id =
      "p_" +
      Date.now() +
      "_" +
      Math.random()
        .toString(36)
        .substring(2, 10);


    sessionStorage.setItem(
      "mr_reaper_player_id",
      id
    );
  }


  return id;
}


// =========================================================
// PLAYER NAME
// =========================================================

function getPlayerName() {

  const input =
    $("playerNameInput");


  let name =
    input?.value?.trim();


  if (!name) {

    name =
      sessionStorage.getItem(
        "mr_reaper_player_name"
      );
  }


  if (!name) {
    name = "Player";
  }


  sessionStorage.setItem(
    "mr_reaper_player_name",
    name
  );


  return name;
}


// =========================================================
// ROOM CODE
// =========================================================

function generateRoomCode() {

  const chars =
    "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";


  let code = "";


  for (
    let i = 0;
    i < 5;
    i++
  ) {

    code +=
      chars[
        Math.floor(
          Math.random() *
          chars.length
        )
      ];
  }


  return code;
}


// =========================================================
// SCREEN CONTROL
// =========================================================

function showScreen(screen) {

  const screens = [
    $("entryPage"),
    $("lobbyPage"),
    $("gamePage")
  ];


  screens.forEach(element => {

    if (element) {
      element.classList.remove(
        "active"
      );
    }
  });


  if (screen === "entry") {
    $("entryPage")?.classList.add("active");
  }


  if (screen === "lobby") {
    $("lobbyPage")?.classList.add("active");
  }


  if (screen === "game") {
    $("gamePage")?.classList.add("active");
  }
}


// =========================================================
// ROOM CODE UI
// =========================================================

function updateRoomCode(code) {

  $("roomCodeDisplay").textContent =
    code || "-----";
}


// =========================================================
// PLAYER COUNT
// =========================================================

function updatePlayerCount(count) {

  $("playerCount").textContent =
    count;

  $("gamePlayerCount").textContent =
    count;
}


// =========================================================
// ROUND
// =========================================================

function updateRound(round) {

  $("roundDisplay").textContent =
