}


/* =========================================================
   GET ROOM
========================================================= */

async function getRoom(code) {

  const {
    data,
    error
  } =
    await supabaseClient
      .from("rooms")
      .select("*")
      .eq("code", code)
      .maybeSingle();

  if (error) {
    throw error;
  }

  return data;
}


/* =========================================================
   GET PLAYERS
========================================================= */

async function getPlayers(code) {

  const {
    data,
    error
  } =
    await supabaseClient
      .from("players")
      .select("*")
      .eq("room_code", code)
      .order(
        "created_at",
        {
          ascending: true
        }
      );

  if (error) {
    throw error;
  }

  return data || [];
}


/* =========================================================
   UPDATE ROOM UI
========================================================= */

function updateRoomUI(
  room,
  players
) {

  currentRoom = room;

  roomCodeDisplay.textContent =
    room.code;

  playerCount.textContent =
    `${players.length}/30`;

  gamePlayerCount.textContent =
    players.length;

  roundDisplay.textContent =
    room.round || 1;

  renderPlayers(players);

  const isHost =
    room.host_id === currentPlayer.id;

  startGameBtn.style.display =
    isHost ? "block" : "none";

  if (players.length < 2) {

    lobbyMessage.textContent =
      isHost
        ? "Waiting for at least one more player..."
        : "Waiting for the host to start the game.";

  } else {

    lobbyMessage.textContent =
      isHost
        ? "Players are ready. Start the game."
        : "Waiting for the host to start the game.";
  }
}


/* =========================================================
   RENDER PLAYERS
========================================================= */

function renderPlayers(players) {

  if (!players.length) {

    playersList.innerHTML = `
      <div class="empty-players">
        No players in this room.
      </div>
    `;

    return;
  }

  playersList.innerHTML =
    players
      .map((player, index) => {

        const isHost =
          currentRoom &&
          player.id === currentRoom.host_id;

        return `
          <div class="player-row">

            <span class="player-number">
              ${index + 1}
            </span>

            <span class="player-name">
              ${escapeHtml(player.name)}
            </span>

            ${
              isHost
                ? `<span class="host-badge">HOST</span>`
                : ""
            }

          </div>
        `;
      })
      .join("");
}


/* =========================================================
   ESCAPE HTML
========================================================= */

function escapeHtml(value) {

  return String(value)
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}


/* =========================================================
   REFRESH CURRENT ROOM
========================================================= */

async function refreshCurrentRoom() {

  if (
    !supabaseClient ||
    !currentRoom
  ) {
    return;
  }

  try {

    const room =
      await getRoom(
        currentRoom.code
      );

    if (!room) {

      clearSession();

      showPage(entryPage);

      showToast(
        "This room no longer exists.",
        "error"
      );

      return;
    }

    const players =
      await getPlayers(
        room.code
      );

    currentRoom = room;

    updateRoomUI(
      room,
      players
    );

    if (
      room.state === "playing"
    ) {

      showGameScreen(
        room,
        players
      );

    } else {

      showPage(lobbyPage);
    }

  } catch (error) {

    console.error(
      error
    );

    showToast(
      readableDatabaseError(error),
      "error"
    );
  }
}


/* =========================================================
   CREATE ROOM
========================================================= */

async function createRoom() {

  if (!supabaseClient) {

    showEntryMessage(
      "Database connection is not ready. Try again.",
      "error"
    );

    return;
  }

  const name =
    validateName();

  if (!name) {
    return;
  }

  /*
    Generate the room code BEFORE any database request.

    This means the user immediately has a code being created
    instead of staring at "Connecting..."
  */

  const playerId =
    getOrCreatePlayerId();

  savePlayerName(name);

  setButtonLoading(
    createRoomBtn,
    true
  );

  showEntryMessage(
    "Creating room...",
    "info"
  );

  setSystemStatus(
    "Creating room...",
    "loading"
  );

  try {

    let createdRoom = null;

    /*
      Try several times in the extremely unlikely event
      that a generated code already exists.
    */

    for (
      let attempt = 0;
      attempt < 5;
      attempt++
    ) {

      const code =
        generateRoomCode();

      const {
        data,
        error
      } =
        await supabaseClient
          .from("rooms")
          .insert({
            code: code,
            host_id: playerId,
            state: "lobby",
            round: 0
          })
          .select()
          .single();

      if (!error) {

        createdRoom = data;

        break;
      }

      if (
        error.code !== "23505"
      ) {

        throw error;
      }
    }

    if (!createdRoom) {

      throw new Error(
        "Unable to generate a unique room code."
      );
    }

    /*
      Add host as first player.
    */

    const {
      error: playerError
    } =
      await supabaseClient
        .from("players")
        .upsert(
          {
            id: playerId,
            room_code: createdRoom.code,
            name: name,
            status: "alive"
          },
          {
            onConflict: "id"
          }
        );

    if (playerError) {

      /*
        If adding the player fails, remove the room
        we just created so we don't leave an orphan room.
      */

      await supabaseClient
        .from("rooms")
        .delete()
        .eq(
          "code",
          createdRoom.code
        );

      throw playerError;
    }

    currentPlayer = {
      id: playerId,
      name: name
    };

    currentRoom =
      createdRoom;

    saveRoomCode(
      createdRoom.code
    );

    roomCodeInput.value =
      createdRoom.code;

    await refreshCurrentRoom();

    subscribeToRoom(
      createdRoom.code
    );

    showToast(
      `Room ${createdRoom.code} created.`,
      "success"
    );

    setSystemStatus(
      "Room online",
      "online"
    );

  } catch (error) {

    console.error(
      "Create room failed:",
      error
    );

    showEntryMessage(
      readableDatabaseError(error),
      "error"
    );

    setSystemStatus(
      "Connection error",
      "error"
    );

  } finally {

    setButtonLoading(
      createRoomBtn,
      false
    );
  }
}


/* =========================================================
   JOIN ROOM
========================================================= */

async function joinRoom() {

  if (!supabaseClient) {

    showEntryMessage(
      "Database connection is not ready. Try again.",
      "error"
    );

    return;
  }

  const name =
    validateName();

  if (!name) {
    return;
  }

  const code =
    roomCodeInput.value
      .trim()
      .toUpperCase();

  if (!/^[A-Z0-9]{5}$/.test(code)) {

    showEntryMessage(
      "Enter a valid 5-character room code.",
      "error"
    );

    roomCodeInput.focus();

    return;
  }

  const playerId =
    getOrCreatePlayerId();

  savePlayerName(name);

  setButtonLoading(
    joinRoomBtn,
    true
  );

  showEntryMessage(
    "Joining room...",
    "info"
  );

  setSystemStatus(
    "Joining room...",
    "loading"
  );

  try {

    const room =
      await getRoom(code);

    if (!room) {

      throw new Error(
        "Room not found. Check the code and try again."
      );
    }

    const players =
      await getPlayers(code);

    if (
      players.length >= 30
    ) {

      throw new Error(
        "This room is full."
      );
    }

    if (
      room.state === "playing"
    ) {

      throw new Error(
        "This game has already started."
      );
    }

    /*
      Upsert prevents the previous duplicate primary-key
      problem if the same browser reconnects.
    */

    const {
      error
    } =
      await supabaseClient
        .from("players")
        .upsert(
          {
            id: playerId,
            room_code: code,
            name: name,
            status: "alive"
          },
          {
            onConflict: "id"
          }
        );

    if (error) {
      throw error;
    }

    currentPlayer = {
      id: playerId,
      name: name
    };

    currentRoom =
      room;

    saveRoomCode(code);

    await refreshCurrentRoom();

    subscribeToRoom(code);

    showToast(
      `Joined room ${code}.`,
      "success"
    );

    setSystemStatus(
      "Room online",
      "online"
    );

  } catch (error) {

    console.error(
      "Join room failed:",
      error
    );

    showEntryMessage(
      readableDatabaseError(error),
      "error"
    );

    setSystemStatus(
      "Connection error",
      "error"
    );

  } finally {

    setButtonLoading(
      joinRoomBtn,
      false
    );
  }
}


/* =========================================================
   START GAME
========================================================= */

async function startGame() {

  if (
    !supabaseClient ||
    !currentRoom ||
    !currentPlayer
  ) {
    return;
  }

  if (
    currentRoom.host_id !==
    currentPlayer.id
  ) {

    showToast(
      "Only the host can start the game.",
      "error"
    );

    return;
  }

  setButtonLoading(
    startGameBtn,
    true
  );

  try {

    const players =
      await getPlayers(
        currentRoom.code
      );

    if (players.length < 2) {

      throw new Error(
        "At least 2 players are required."
      );
    }

    if (players.length > 30) {

      throw new Error(
        "Maximum 30 players allowed."
      );
    }

    const {
      data,
      error
    } =
      await supabaseClient
        .from("rooms")
        .update({
          state: "playing",
          round: 1
        })
        .eq(
          "code",
          currentRoom.code
        )
        .eq(
          "host_id",
          currentPlayer.id
        )
        .select()
        .single();

    if (error) {
      throw error;
    }

    currentRoom =
      data;

    showGameScreen(
      currentRoom,
      players
    );

    showToast(
      "Game started.",
      "success"
    );

  } catch (error) {

    console.error(
      "Start game failed:",
      error
    );

    showToast(
      readableDatabaseError(error),
      "error"
    );

  } finally {

    setButtonLoading(
      startGameBtn,
      false
    );
  }
}


