}


// =========================================================
// RENDER PLAYERS
// =========================================================

function renderPlayers(players) {

  const list =
    $("playersList");


  list.innerHTML = "";


  if (!players.length) {

    list.innerHTML = `
      <div class="empty-players">
        Waiting for players...
      </div>
    `;

    return;
  }


  players.forEach(player => {

    const item =
      document.createElement("div");


    item.className =
      "player-item";


    const name =
      document.createElement("span");


    name.className =
      "player-name";


    name.textContent =
      player.name || "Player";


    const right =
      document.createElement("span");


    if (
      currentRoom &&
      player.id ===
      currentRoom.host_id
    ) {

      right.className =
        "player-host";

      right.textContent =
        "HOST 👑";
    }


    item.appendChild(name);

    item.appendChild(right);

    list.appendChild(item);
  });
}


// =========================================================
// GET ROOM
// =========================================================

async function getRoom(code) {

  const {
    data,
    error
  } =
    await supabaseClient
      .from("rooms")
      .select("*")
      .eq("code", code)
      .maybeSingle();


  if (error) {
    throw error;
  }


  return data;
}


// =========================================================
// GET PLAYERS
// =========================================================

async function getPlayers(code) {

  const {
    data,
    error
  } =
    await supabaseClient
      .from("players")
      .select("*")
      .eq("room_code", code)
      .order(
        "created_at",
        {
          ascending: true
        }
      );


  if (error) {
    throw error;
  }


  return data || [];
}


// =========================================================
// REFRESH PLAYERS
// =========================================================

async function refreshPlayers() {

  if (!currentRoom) {
    return [];
  }


  const players =
    await getPlayers(
      currentRoom.code
    );


  renderPlayers(players);

  updatePlayerCount(
    players.length
  );


  return players;
}


// =========================================================
// CREATE ROOM
// =========================================================

async function createRoom() {

  if (actionRunning) return;


  actionRunning = true;

  lockButtons(true);

  loading(
    "Creating room..."
  );


  try {

    const playerId =
      getPlayerId();


    const playerName =
      getPlayerName();


    let roomCode = null;


    for (
      let attempt = 0;
      attempt < 20;
      attempt++
    ) {

      const candidate =
        generateRoomCode();


      const existing =
        await getRoom(
          candidate
        );


      if (!existing) {

        roomCode =
          candidate;

        break;
      }
    }


    if (!roomCode) {

      throw new Error(
        "Could not create a unique room."
      );
    }


    const {
      data: room,
      error: roomError
    } =
      await supabaseClient
        .from("rooms")
        .insert({
          code: roomCode,
          host_id: playerId,
          state: "lobby",
          round: 0
        })
        .select()
        .single();


    if (roomError) {
      throw roomError;
    }


    const {
      error: playerError
    } =
      await supabaseClient
        .from("players")
        .upsert(
          {
            id: playerId,
            room_code: roomCode,
            name: playerName,
            status: "alive"
          },
          {
            onConflict: "id"
          }
        );


    if (playerError) {
      throw playerError;
    }


    currentRoom =
      room;


    currentPlayer = {
      id: playerId,
      room_code: roomCode,
      name: playerName,
      status: "alive"
    };


    sessionStorage.setItem(
      "mr_reaper_room_code",
      roomCode
    );


    updateRoomCode(
      roomCode
    );


    await refreshPlayers();


    await subscribeToRoom(
      roomCode
    );


    showScreen("lobby");


    online(
      `Room ${roomCode} created`
    );


  } catch (error) {

    console.error(
      "CREATE ERROR:",
      error
    );


    errorStatus(
      error.message ||
      "Could not create room."
    );


  } finally {

    actionRunning = false;

    lockButtons(false);
  }
}


// =========================================================
// JOIN ROOM
// =========================================================

async function joinRoom() {

  if (actionRunning) return;


  actionRunning = true;

  lockButtons(true);

  loading(
    "Joining room..."
  );


  try {

    let code =
      $("roomCodeInput")
        .value
        .trim()
        .toUpperCase();


    code =
      code.replace(
        /[^A-Z0-9]/g,
        ""
      );


    if (code.length !== 5) {

      throw new Error(
        "Enter a valid 5-character room code."
      );
    }


    const room =
      await getRoom(code);


    if (!room) {

      throw new Error(
        "Room not found."
      );
    }


    if (
      room.state ===
      "playing"
    ) {

      throw new Error(
        "That game has already started."
      );
    }


    const players =
      await getPlayers(code);


    if (
      players.length >= 30
    ) {

      throw new Error(
        "Room is full."
      );
    }


    const playerId =
      getPlayerId();


    const playerName =
      getPlayerName();


    const {
      error
    } =
      await supabaseClient
        .from("players")
        .upsert(
          {
            id: playerId,
            room_code: code,
            name: playerName,
            status: "alive"
          },
          {
            onConflict: "id"
          }
        );


    if (error) {
      throw error;
    }


    currentRoom =
      room;


    currentPlayer = {
      id: playerId,
      room_code: code,
      name: playerName,
      status: "alive"
    };


    sessionStorage.setItem(
      "mr_reaper_room_code",
      code
    );


    updateRoomCode(code);


    await refreshPlayers();


    await subscribeToRoom(code);


    showScreen("lobby");


    online(
      `Joined room ${code}`
    );


  } catch (error) {

    console.error(
      "JOIN ERROR:",
      error
    );


    errorStatus(
      error.message ||
      "Could not join room."
    );


  } finally {

    actionRunning = false;

    lockButtons(false);
  }
}


// =========================================================
// START GAME
// =========================================================

async function startGame() {

  if (actionRunning) return;


  if (!currentRoom) {

    errorStatus(
      "You are not in a room."
    );

    return;
  }


  if (
    currentRoom.host_id !==
    getPlayerId()
  ) {

    errorStatus(
      "Only the host can start the game."
    );

    return;
  }


  actionRunning = true;

  lockButtons(true);

  loading(
    "Starting game..."
  );


  try {

    const players =
      await refreshPlayers();


    if (players.length < 2) {

      throw new Error(
        "You need at least 2 players."
      );
    }


    const {
      data,
      error
    } =
      await supabaseClient
        .from("rooms")
        .update({
          state: "playing",
          round: 1
        })
        .eq(
          "code",
          currentRoom.code
        )
        .select()
        .single();


    if (error) {
      throw error;
    }


    currentRoom =
      data;


    updateRound(1);


    showScreen("game");


    $("gameMessage").textContent =
      "THE GAME HAS BEGUN.";


    online(
      "GAME STARTED"
    );


  } catch (error) {

    console.error(
      "START ERROR:",
      error
    );


    errorStatus(
      error.message ||
      "Could not start game."
    );


  } finally {

    actionRunning = false;

    lockButtons(false);
  }
}


// =========================================================
// LEAVE ROOM
// =========================================================

async function leaveRoom() {

  if (actionRunning) return;


  actionRunning = true;

  lockButtons(true);

  loading(
    "Leaving room..."
  );


  try {

    if (!currentRoom) {

      showScreen("entry");

      return;
    }


    const playerId =
      getPlayerId();


    await supabaseClient
      .from("players")
      .delete()
      .eq(
        "id",
        playerId
      );


    const remaining =
      await getPlayers(
        currentRoom.code
      );


    if (
      remaining.length === 0
    ) {

      await supabaseClient
        .from("rooms")
        .delete()
        .eq(
          "code",
          currentRoom.code
        );

    } else if (
      currentRoom.host_id ===
      playerId
    ) {

      await supabaseClient
        .from("rooms")
        .update({
          host_id:
            remaining[0].id
        })
        .eq(
          "code",
          currentRoom.code
        );
    }


    if (roomChannel) {

      await supabaseClient
        .removeChannel(
          roomChannel
        );

      roomChannel = null;
    }


    sessionStorage.removeItem(
      "mr_reaper_room_code"
    );


    currentRoom = null;

    currentPlayer = null;


    updateRoomCode("-----");

    updatePlayerCount(0);


    showScreen("entry");


    online(
      "You left the room"
    );


  } catch (error) {

    console.error(
      "LEAVE ERROR:",
      error
    );


    errorStatus(
      error.message ||
      "Could not leave room."
    );


  } finally {

    actionRunning = false;

    lockButtons(false);
  }
}


// =========================================================
// REALTIME ROOM
// =========================================================

async function subscribeToRoom(code) {

  if (roomChannel) {

    try {

      await supabaseClient
        .removeChannel(
          roomChannel
        );

    } catch (_) {}

    roomChannel = null;
  }


  roomChannel =
    supabaseClient
      .channel(
        "mr-reaper-" +
        code +
        "-" +
        Date.now()
      );


  roomChannel
    .on(
      "postgres_changes",
      {
        event: "*",
        schema: "public",
        table: "players",
        filter:
          "room_code=eq." + code
      },
      async () => {

        try {

          await refreshPlayers();

        } catch (error) {

          console.error(
            "PLAYER UPDATE ERROR:",
            error
          );
        }
      }
    )
    .on(
      "postgres_changes",
      {
        event: "*",
        schema: "public",
        table: "rooms",
        filter:
          "code=eq." + code
      },
      async payload => {

        console.log(
          "ROOM UPDATE:",
          payload
        );


        if (!payload.new) {
          return;
        }


        currentRoom =
          payload.new;


        updateRoomCode(
          currentRoom.code
        );


        updateRound(
          currentRoom.round
        );


        if (
          currentRoom.state ===
          "playing"
        ) {

          showScreen("game");


          $("gameMessage").textContent =
            "THE GAME HAS BEGUN.";


          online(
            "GAME IN PROGRESS"
          );

        } else {

          showScreen("lobby");


          online(
            "LOBBY UPDATED"
          );
        }
      }
    )
    .subscribe(status => {

      console.log(
        "Realtime:",
        status
      );


      if (
        status ===
        "SUBSCRIBED"
      ) {

        online(
          "REALTIME ONLINE"
        );
      }


      if (
        status ===
        "CHANNEL_ERROR"
      ) {

        errorStatus(
          "Realtime connection error."
        );
      }
    });
}


// =========================================================
// RETURN TO LOBBY
// =========================================================

async function returnToLobby() {

  if (!currentRoom) {

    showScreen("entry");

    return;
  }


  loading(
    "Returning to lobby..."
  );


  try {

    const room =
      await getRoom(
        currentRoom.code
      );


    if (!room) {

      sessionStorage.removeItem(
        "mr_reaper_room_code"
      );


      currentRoom = null;

      showScreen("entry");

      errorStatus(
        "Room no longer exists."
      );

      return;
    }


    currentRoom =
      room;


    await refreshPlayers();


    updateRoomCode(
      room.code
    );


    updateRound(
      room.round
    );


    showScreen("lobby");


    online(
      "LOBBY READY"
    );


  } catch (error) {

    console.error(error);

    errorStatus(
      "Could not load lobby."
    );
  }
}


// =========================================================
// RESTORE SESSION
// =========================================================

async function restoreSession() {

  const savedRoom =
    sessionStorage.getItem(
      "mr_reaper_room_code"
    );


  if (!savedRoom) {

    showScreen("entry");

    online(
      "REAPER CONNECTION ONLINE"
    );

    return;
  }


  loading(
    "Restoring session..."
  );


  try {

    const room =
      await getRoom(
        savedRoom
      );


    if (!room) {

      sessionStorage.removeItem(
        "mr_reaper_room_code"
      );


      showScreen("entry");

      online("READY");

      return;
    }


    const playerId =
      getPlayerId();


    const {
      data: player
    } =
      await supabaseClient
        .from("players")
        .select("*")
        .eq(
          "id",
          playerId
        )
        .eq(
          "room_code",
          savedRoom
        )
        .maybeSingle();


    if (!player) {

      sessionStorage.removeItem(
        "mr_reaper_room_code"
      );


      showScreen("entry");

      online("READY");

      return;
    }


    currentRoom =
      room;


    currentPlayer =
      player;


    updateRoomCode(
      room.code
    );


    updateRound(
      room.round
    );


    await refreshPlayers();


    await subscribeToRoom(
      room.code
    );


    if (
      room.state ===
      "playing"
    ) {

      showScreen("game");

    } else {

      showScreen("lobby");
    }


    online(
      "SESSION RESTORED"
    );


  } catch (error) {

    console.error(
      "RESTORE ERROR:",
      error
    );


    showScreen("entry");


    errorStatus(
      "Session could not be restored."
    );
  }
}


