/* =========================================================
   DOM HELPERS
   ========================================================= */

function getElement(...ids) {
  for (const id of ids) {
    const element =
      document.getElementById(id);

    if (element) {
      return element;
    }
  }

  return null;
}


function setElementText(
  text,
  ...ids
) {
  const element =
    getElement(...ids);

  if (element) {
    element.textContent = text;
  }
}


function showElement(...ids) {
  const element =
    getElement(...ids);

  if (element) {
    element.style.display = "";
  }
}


function hideElement(...ids) {
  const element =
    getElement(...ids);

  if (element) {
    element.style.display = "none";
  }
}


function setStatus(message) {
  console.log(
    "[MR REAPER]",
    message
  );

  setElementText(
    message,
    "status",
    "gameStatus",
    "connectionStatus",
    "message"
  );
}


