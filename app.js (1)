const SUPABASE_URL =
  "https://hyyevttvizxlsyuylbgm.supabase.co";

const SUPABASE_KEY =
  "sb_publishable_ks2EQ7mWi7jTQvrdO-ftUA_1_IRys4S";

let supabaseClient = null;
let currentPlayer = null;
let currentRoom = null;
