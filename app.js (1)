function showEntry() {
  hideEverything();

  const el = getEl(
    "entryPage",
    "entry",
    "loginPage",
    "login"
  );

  if (el) {
    el.style.display = "block";
  }
}

function showLobby() {
  hideEverything();

  const el = getEl(
    "lobbyPage",
    "lobby",
