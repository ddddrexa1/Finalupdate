/* =========================================================
   REFRESH ROOM
   ========================================================= */

async function refreshRoom() {
  if (!currentRoom) {
    return;
  }

  try {
    /*
     * Get room.
     */

    const {
      data: room,
      error: roomError
    } =
      await supabaseClient
        .from("rooms")
        .select("*")
        .eq(
          "code",
          currentRoom
        )
        .maybeSingle();

    if (roomError) {
      throw roomError;
    }

    if (!room) {
      setStatus(
        "ROOM CLOSED"
      );

      await resetLocalState();

      return;
    }

    roomData =
      room;

    /*
     * Update host.
     */

    isHost =
      room.host_id ===
      getPlayerId();

    /*
     * Get players.
     */

    const {
      data: playerRows,
      error: playerError
    } =
      await supabaseClient
        .from("players")
        .select(
          "id, room_code, name, status, created_at"
        )
        .eq(
          "room_code",
          currentRoom
        )
        .order(
          "created_at",
          {
            ascending: true
          }
        );

    if (playerError) {
      throw playerError;
    }

    players =
      playerRows || [];

    /*
     * Render.
     */

    renderPlayers();

    updateStartButton();

    /*
     * Game started?
     */

    if (
      room.state === "playing"
    ) {
      startGameScreen(room);
    }

  } catch (error) {
    console.error(
      "REFRESH ROOM ERROR:",
      error
    );
  }
}


/* =========================================================
   RENDER PLAYER LIST
   ========================================================= */

function renderPlayers() {
  const list =
    getElement(
      "playerList",
      "playersList",
      "lobbyPlayers",
      "players"
    );

  /*
   * Player count always updates even if the
   * HTML list doesn't exist.
   */

  setElementText(
    `${players.length}/${MAX_PLAYERS}`,
    "playerCount",
    "playersCount",
    "roomPlayerCount"
  );

  if (!list) {
    return;
  }

  list.innerHTML = "";

  players.forEach(
    (player, index) => {
      const row =
        document.createElement(
          "div"
        );

      row.className =
        "player-row";

      if (
        player.id ===
        getPlayerId()
      ) {
        row.classList.add(
          "current-player"
        );
      }

      if (
        roomData &&
        player.id ===
        roomData.host_id
      ) {
        row.classList.add(
          "host-player"
        );
      }

      const number =
        document.createElement(
          "span"
        );

      number.className =
        "player-number";

      number.textContent =
        String(index + 1);

      const name =
        document.createElement(
          "span"
        );

      name.className =
        "player-name";

      name.textContent =
        player.name ||
        "Player";

      const badge =
        document.createElement(
          "span"
        );

      badge.className =
        "player-badge";

      if (
        roomData &&
        player.id ===
        roomData.host_id
      ) {
        badge.textContent =
          "HOST";
      } else {
        badge.textContent =
          "PLAYER";
      }

      row.appendChild(
        number
      );

      row.appendChild(
        name
      );

      row.appendChild(
        badge
      );

      list.appendChild(
        row
      );
    }
  );
}


/* =========================================================
   UPDATE START BUTTON
   ========================================================= */

function updateStartButton() {
  const button =
    getElement(
      "startGameBtn",
      "startGame",
      "start",
      "btnStart"
    );

  if (!button) {
    return;
  }

  button.style.display =
    isHost ? "" : "none";

  button.disabled =
    !isHost ||
    players.length <
      MIN_PLAYERS ||
    players.length >
      MAX_PLAYERS ||
    !roomData ||
    roomData.state !==
      "lobby";

  if (
    players.length <
    MIN_PLAYERS
  ) {
    button.textContent =
      "WAITING FOR PLAYERS";
  } else {
    button.textContent =
      "START GAME";
  }
}


/* =========================================================
   START GAME
   ========================================================= */

async function startGame() {
  if (!currentRoom) {
    return;
  }

  if (!isHost) {
    alert(
      "Only the host can start the game."
    );

    return;
  }

  /*
   * Always get fresh player count.
   */

  const {
    data: freshPlayers,
    error
  } =
    await supabaseClient
      .from("players")
      .select("id")
      .eq(
        "room_code",
        currentRoom
      );

  if (error) {
    console.error(error);

    alert(
      "Could not check players."
    );

    return;
  }

  const playerCount =
    freshPlayers.length;

  if (
    playerCount <
    MIN_PLAYERS
  ) {
    alert(
      "At least 2 players are required."
    );

    return;
  }

  if (
    playerCount >
    MAX_PLAYERS
  ) {
    alert(
      "Maximum 30 players allowed."
    );

    return;
  }

  setStatus(
    "STARTING GAME..."
  );

  try {
    /*
     * Host changes lobby -> playing.
     */

    const {
      data,
      error: updateError
    } =
      await supabaseClient
        .from("rooms")
        .update({
          state: "playing",
          round: 1
        })
        .eq(
          "code",
          currentRoom
        )
        .eq(
          "host_id",
          getPlayerId()
        )
        .select()
        .single();

    if (updateError) {
      throw updateError;
    }

    roomData =
      data;

    startGameScreen(
      data
    );

  } catch (error) {
    console.error(
      "START GAME ERROR:",
      error
    );

    setStatus(
      "GAME START FAILED"
    );

    alert(
      error.message ||
      "Unable to start game."
    );
  }
}


/* =========================================================
   START GAME SCREEN
   ========================================================= */

function startGameScreen(room) {
  if (gameStarted) {
    return;
  }

  gameStarted = true;

  roomData =
    room;

  hideElement(
    "lobbyScreen",
    "lobby",
    "roomScreen"
  );

  showElement(
    "gameScreen",
    "game",
    "gameContainer"
  );

  setElementText(
    String(room.round || 1),
    "roundNumber",
    "currentRound",
    "gameRound"
  );

  setStatus(
    "ROUND " +
    (room.round || 1) +
    " — GAME STARTED"
  );

  /*
   * Connect this controller to the actual
   * game engine if another file exposes it.
   */

  if (
    typeof window.initializeGame ===
    "function"
  ) {
    window.initializeGame(
      currentRoom,
      currentPlayer,
      players
    );
  }

  if (
    typeof window.startReaperGame ===
    "function"
  ) {
    window.startReaperGame(
      currentRoom,
      currentPlayer,
      players
    );
  }

  if (
    typeof window.initializeReaperGame ===
    "function"
  ) {
    window.initializeReaperGame(
      currentRoom,
      currentPlayer,
      players
    );
  }
}


/* =========================================================
   REALTIME
   ========================================================= */

async function subscribeToRoom() {
  await unsubscribeFromRoom();

  if (!currentRoom) {
    return;
  }

  const channelName =
    "reaper-room-" +
    currentRoom;

  roomChannel =
    supabaseClient.channel(
      channelName
    );

  roomChannel
    .on(
      "postgres_changes",
      {
        event: "*",
        schema: "public",
        table: "rooms",
        filter:
          "code=eq." +
          currentRoom
      },
      payload => {
        console.log(
          "ROOM REALTIME:",
          payload
        );

        refreshRoom();
      }
    )
    .on(
      "postgres_changes",
      {
        event: "*",
        schema: "public",
        table: "players",
        filter:
          "room_code=eq." +
          currentRoom
      },
      payload => {
        console.log(
          "PLAYER REALTIME:",
          payload
        );

        refreshRoom();
      }
    )
    .subscribe(
      status => {
        console.log(
          "REALTIME:",
          status
        );

        if (
          status ===
          "SUBSCRIBED"
        ) {
          console.log(
            "REAPER REALTIME ONLINE"
          );
        }

        if (
          status ===
          "CHANNEL_ERROR"
        ) {
          console.warn(
            "Realtime channel error."
          );
        }
      }
    );
}


/* =========================================================
   UNSUBSCRIBE
   ========================================================= */

async function unsubscribeFromRoom() {
  if (!roomChannel) {
    return;
  }

  try {
    await supabaseClient
      .removeChannel(
        roomChannel
      );
  } catch (error) {
    console.warn(
      "Channel cleanup:",
      error
    );
  }

  roomChannel =
    null;
}


