function showGame() {
  hideEverything();

  const el = getEl(
    "gamePage",
    "game"
  );

  if (el) {
    el.style.display = "block";
  }

  gameStarted = true;
  startGame();
}


/* =========================================================
   CREATE ROOM
   ========================================================= */

async function createRoom() {
  if (!supabaseClient) {
    if (!initSupabase()) return;
  }

  const name = getName();
  const playerId = getPlayerId();

  setConnection("CREATING ROOM...");

  try {
    let code = null;

    for (let i = 0; i < 10; i++) {
      const candidate =
        generateRoomCode();

      const { data, error } =
        await supabaseClient
          .from("rooms")
          .select("code")
          .eq("code", candidate)
          .maybeSingle();

      if (error) {
        throw error;
      }

      if (!data) {
        code = candidate;
        break;
      }
    }

    if (!code) {
      throw new Error(
        "Unable to generate room code."
      );
    }

    /*
      Clean any previous row belonging
      to this browser/player.
    */

    await supabaseClient
      .from("players")
      .delete()
      .eq("id", playerId);

    const {
      data: room,
      error: roomError
    } = await supabaseClient
      .from("rooms")
      .insert({
        code: code,
        host_id: playerId,
        state: "lobby",
        round: 0
      })
      .select()
      .single();

    if (roomError) {
      throw roomError;
    }

    const {
      data: player,
      error: playerError
    } = await supabaseClient
      .from("players")
      .insert({
        id: playerId,
        room_code: code,
        name: name,
        status: "alive"
      })
      .select()
      .single();

    if (playerError) {
      await supabaseClient
        .from("rooms")
        .delete()
        .eq("code", code);

      throw playerError;
    }

    currentPlayer = player;
    currentRoom = room;
    isHost = true;

    saveSession();

    await subscribeToRoom();

    showLobby();

    setConnection(
      "ROOM CREATED — " + code
    );

  } catch (err) {
    console.error(err);

    notify(
      "CREATE ROOM ERROR: " +
      (err.message || "Unknown error")
    );

    setConnection(
      "REAPER CONNECTION ONLINE"
    );
  }
}


/* =========================================================
   JOIN ROOM
   ========================================================= */

async function joinRoom() {
  if (!supabaseClient) {
    if (!initSupabase()) return;
  }

  const code = getRoomCode();
  const name = getName();
  const playerId = getPlayerId();

  if (code.length !== 5) {
    notify("Enter a valid 5-character room code.");
    return;
  }

  setConnection("SEARCHING FOR ROOM...");

  try {
    const {
      data: room,
      error: roomError
    } = await supabaseClient
      .from("rooms")
      .select("*")
      .eq("code", code)
      .maybeSingle();

    if (roomError) {
      throw roomError;
    }

    if (!room) {
      notify("ROOM NOT FOUND.");
      setConnection(
        "REAPER CONNECTION ONLINE"
      );
      return;
    }

    if (room.state !== "lobby") {
      notify(
        "This game has already started."
      );
      return;
    }

    const {
      count,
      error: countError
    } = await supabaseClient
      .from("players")
      .select("*", {
        count: "exact",
        head: true
      })
      .eq("room_code", code)
      .eq("status", "alive");

    if (countError) {
      throw countError;
    }

    if ((count || 0) >= 30) {
      notify("ROOM IS FULL.");
      return;
    }

    /*
      Remove previous player row first.
    */

    await supabaseClient
      .from("players")
      .delete()
      .eq("id", playerId);

    const {
      data: player,
      error: playerError
    } = await supabaseClient
      .from("players")
      .insert({
        id: playerId,
        room_code: code,
        name: name,
        status: "alive"
      })
      .select()
      .single();

    if (playerError) {
      throw playerError;
    }

    currentPlayer = player;
    currentRoom = room;
    isHost =
      room.host_id === playerId;

    saveSession();

    await subscribeToRoom();

    showLobby();

    setConnection(
      "CONNECTED TO ROOM " + code
    );

  } catch (err) {
    console.error(err);

    notify(
      "JOIN ERROR: " +
      (err.message || "Unknown error")
    );

    setConnection(
      "REAPER CONNECTION ONLINE"
    );
  }
}


/* =========================================================
   SESSION
   ========================================================= */

function saveSession() {
  if (currentRoom) {
    sessionStorage.setItem(
      "mr_reaper_room",
      currentRoom.code
    );
  }

  if (currentPlayer) {
    sessionStorage.setItem(
      "mr_reaper_name",
      currentPlayer.name
    );
  }
}

function clearSession() {
  sessionStorage.removeItem(
    "mr_reaper_room"
  );

  sessionStorage.removeItem(
    "mr_reaper_name"
  );
}


/* =========================================================
   LOAD EXISTING SESSION
   ========================================================= */

async function restoreSession() {
  if (!supabaseClient) return false;

  const playerId = getPlayerId();

  const roomCode =
    sessionStorage.getItem(
      "mr_reaper_room"
    );

  if (!roomCode) {
    return false;
  }

  try {
    const {
      data: player
    } = await supabaseClient
      .from("players")
      .select("*")
      .eq("id", playerId)
      .maybeSingle();

    if (!player) {
      clearSession();
      return false;
    }

    const {
      data: room
    } = await supabaseClient
      .from("rooms")
      .select("*")
      .eq("code", roomCode)
      .maybeSingle();

    if (!room) {
      clearSession();
      return false;
    }

    currentPlayer = player;
    currentRoom = room;
    isHost =
      room.host_id === playerId;

    await subscribeToRoom();

    if (room.state === "playing") {
      showGame();
    } else {
      showLobby();
    }

    return true;

  } catch (err) {
    console.error(err);
    clearSession();
    return false;
  }
}


/* =========================================================
   REALTIME
   ========================================================= */

async function subscribeToRoom() {
  if (!currentRoom) return;

  if (roomChannel) {
    try {
      await supabaseClient
        .removeChannel(roomChannel);
    } catch (_) {}
  }

  const roomCode =
    currentRoom.code;

  roomChannel =
    supabaseClient.channel(
      "reaper-room-" + roomCode
    );

  roomChannel
    .on(
      "postgres_changes",
      {
        event: "*",
        schema: "public",
        table: "players",
        filter:
          "room_code=eq." + roomCode
      },
      payload => {
        log(
          "Player update:",
          payload
        );

        updateLobby();

        if (
          payload.new &&
          payload.new.id ===
            getPlayerId()
        ) {
          currentPlayer =
            payload.new;
        }
      }
    )
    .on(
      "postgres_changes",
      {
        event: "*",
        schema: "public",
        table: "rooms",
        filter:
          "code=eq." + roomCode
      },
      payload => {
        log(
          "Room update:",
          payload
        );

        if (payload.new) {
          currentRoom =
            payload.new;

          isHost =
            currentRoom.host_id ===
            getPlayerId();

          if (
            currentRoom.state ===
            "playing"
          ) {
            if (!gameStarted) {
              showGame();
            }
          } else {
            updateLobby();
          }
        }
      }
    )
    .subscribe(status => {
      console.log(
        "Realtime status:",
        status
      );

      if (
        status === "SUBSCRIBED"
      ) {
        setConnection(
          "REALTIME ONLINE"
        );
      }
    });
}


/* =========================================================
   UPDATE LOBBY
   ========================================================= */

async function updateLobby() {
  if (!currentRoom || !supabaseClient) {
    return;
  }

  const roomCode =
    currentRoom.code;

  /*
    Room code
  */

  const codeElements = document.querySelectorAll(
    "#displayRoomCode, #roomDisplay, #roomCodeDisplay, .room-code-display, [data-room-code]"
  );

  codeElements.forEach(el => {
    el.textContent = roomCode;
  });

  /*
    Host label
  */

  const hostElements =
    document.querySelectorAll(
      "#hostStatus, #hostLabel, [data-host]"
    );

  hostElements.forEach(el => {
    el.textContent =
      isHost
        ? "HOST"
        : "PLAYER";
  });

  /*
    Get players
  */

  try {
    const {
      data: players,
      error
    } = await supabaseClient
      .from("players")
      .select("*")
      .eq("room_code", roomCode)
      .order("created_at", {
        ascending: true
      });

    if (error) {
      throw error;
    }

    renderPlayers(
      players || []
    );

    updatePlayerCount(
      players || []
    );

    updateStartButton(
      players || []
    );

  } catch (err) {
    console.error(err);
  }
}


/* =========================================================
   RENDER PLAYERS
   ========================================================= */

function renderPlayers(players) {
  const container = getEl(
    "playersList",
    "playerList",
    "lobbyPlayers",
    "players",
    "player-container"
  );

  if (!container) return;

  container.innerHTML = "";

  players.forEach((player, index) => {
    const item =
      document.createElement("div");

    item.className =
      "reaper-player";

    const crown =
      player.id ===
      currentRoom?.host_id
        ? " 👑"
        : "";

    item.innerHTML = `
      <span class="player-number">
        ${index + 1}
      </span>

      <span class="player-name">
        ${escapeHTML(
          player.name
        )}${crown}
      </span>

      <span class="player-status">
        ${player.status || "alive"}
      </span>
    `;

    container.appendChild(item);
  });
}

function updatePlayerCount(players) {
  const count =
    players.length;

  document
    .querySelectorAll(
      "#playerCount, #playersCount, [data-player-count]"
    )
    .forEach(el => {
      el.textContent =
        count + " / 30";
    });
}


/* =========================================================
   START BUTTON
   ========================================================= */

function updateStartButton(players) {
  const button = getEl(
    "startGame",
    "startBtn",
    "startButton",
    "start-game"
  );

  if (!button) return;

  if (!isHost) {
    button.style.display =
      "none";
    return;
  }

  button.style.display =
    "block";

  if (players.length < 2) {
    button.disabled = true;
    button.textContent =
      "WAITING FOR PLAYERS";
  } else {
    button.disabled = false;
    button.textContent =
      "START GAME";
  }
}


/* =========================================================
   START GAME
   ========================================================= */

async function startGame() {
  if (!currentRoom) return;

  if (!isHost) {
    notify(
      "Only the host can start the game."
    );
    return;
  }

  try {
    const {
      count,
      error: countError
    } = await supabaseClient
      .from("players")
      .select("*", {
        count: "exact",
        head: true
      })
      .eq(
        "room_code",
        currentRoom.code
      )
      .eq("status", "alive");

    if (countError) {
      throw countError;
    }

    if ((count || 0) < 2) {
      notify(
        "At least 2 players are required."
      );
      return;
    }

    const {
      data,
      error
    } = await supabaseClient
      .from("rooms")
      .update({
        state: "playing",
        round: 1
      })
      .eq(
        "code",
        currentRoom.code
      )
      .eq(
        "host_id",
        getPlayerId()
      )
      .select()
      .single();

    if (error) {
      throw error;
    }

    currentRoom = data;

    gameStarted = true;

    showGame();

  } catch (err) {
    console.error(err);

    notify(
      "START GAME ERROR: " +
      (err.message || "Unknown error")
    );
  }
}


/* =========================================================
   GAME
   ========================================================= */

function startGame() {
  gameStarted = true;

  const roomCode =
    currentRoom?.code || "";

  document
    .querySelectorAll(
      "#gameRoomCode, [data-game-room]"
    )
    .forEach(el => {
      el.textContent = roomCode;
    });

  /*
    Initial game state.
    The actual game mechanics can be attached
    here without affecting login/lobby.
  */

  const title =
    getEl(
      "gameStatus",
      "roundStatus",
      "gameMessage"
    );

  if (title) {
    title.textContent =
      "ROUND 1 — PREPARE";
  }

  log(
    "Game started in room:",
    roomCode
  );
}


/* =========================================================
   LEAVE ROOM
   ========================================================= */

async function leaveRoom() {
  const playerId =
    getPlayerId();

  try {
    if (roomChannel) {
      await supabaseClient
        .removeChannel(
          roomChannel
        );

      roomChannel = null;
    }

    if (
      currentRoom &&
      currentRoom.host_id ===
        playerId
    ) {
      /*
        Host leaves:
        remove all players and room.
      */

      await supabaseClient
        .from("players")
        .delete()
        .eq(
          "room_code",
          currentRoom.code
        );

      await supabaseClient
        .from("rooms")
        .delete()
        .eq(
          "code",
          currentRoom.code
        );

    } else {
      /*
        Normal player leaves.
      */

      await supabaseClient
        .from("players")
        .delete()
        .eq(
          "id",
          playerId
        );
    }

  } catch (err) {
    console.error(
      "Leave error:",
      err
    );
  }

  currentPlayer = null;
  currentRoom = null;
  isHost = false;
  gameStarted = false;

  clearSession();

  showEntry();

  setConnection(
    "REAPER CONNECTION ONLINE"
  );
}


/* =========================================================
   HTML ESCAPE
   ========================================================= */

function escapeHTML(value) {
  return String(value)
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}


/* =========================================================
   BUTTON BINDING
   ========================================================= */

function bindButton(ids, callback) {
  ids.forEach(id => {
    const el = $(id);

    if (!el) return;

    el.addEventListener(
      "click",
      event => {
        event.preventDefault();
        callback();
      }
    );
  });
}

