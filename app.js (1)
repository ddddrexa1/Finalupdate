/* =========================================================
   GET ROOM
========================================================= */

async function getRoom(code) {

  const {
    data,
    error
  } =
    await supabaseClient
      .from("rooms")
      .select("*")
      .eq("code", code)
      .maybeSingle();

  if (error) {
    throw error;
  }

  return data;
}


/* =========================================================
   GET PLAYERS
========================================================= */

async function getPlayers(code) {

  const {
    data,
    error
  } =
    await supabaseClient
      .from("players")
      .select("*")
      .eq("room_code", code)
      .order(
        "created_at",
        {
          ascending: true
        }
      );

  if (error) {
    throw error;
  }

  return data || [];
}


