/* =========================================================
   SUPABASE INITIALIZATION
========================================================= */

function initializeSupabase() {

  try {

    if (
      !window.supabase ||
      typeof window.supabase.createClient !==
        "function"
    ) {

      setSystemStatus(
        "Supabase library unavailable",
        "error"
      );

      return false;
    }

    supabaseClient =
      window.supabase.createClient(
        SUPABASE_URL,
        SUPABASE_KEY,
        {
          auth: {
            persistSession: false,
            autoRefreshToken: false
          },
          realtime: {
            params: {
              eventsPerSecond: 10
            }
          }
        }
      );

    setSystemStatus(
      "Connection ready",
      "online"
    );

    return true;

  } catch (error) {

    console.error(
      "Supabase initialization error:",
      error
    );

    setSystemStatus(
      "Connection error",
      "error"
    );

    return false;
  }
}


/* =========================================================
   DATABASE ERROR
========================================================= */

function readableDatabaseError(error) {

  if (!error) {
    return "Unknown database error.";
  }

  console.error(
    "Supabase error:",
    error
  );

  if (
    error.code === "23505"
  ) {

    return "That room already exists. Please try again.";
  }

  if (
    error.code === "42501"
  ) {

    return "Database permission denied. Check Supabase RLS policies.";
  }

  if (
    error.code === "PGRST116"
  ) {

    return "The requested room or player could not be found.";
  }

  if (
    error.message
  ) {

    return error.message;
  }

  return "A database error occurred.";
}


/* =========================================================
   VALIDATE NAME
========================================================= */

function validateName() {

  const name =
    playerNameInput.value
      .trim()
      .replace(/\s+/g, " ");

  if (!name) {

    showEntryMessage(
      "Enter your player name first.",
      "error"
    );

    playerNameInput.focus();

    return null;
  }

  if (name.length < 2) {

    showEntryMessage(
      "Your name must contain at least 2 characters.",
      "error"
    );

    playerNameInput.focus();

    return null;
  }

  if (name.length > 20) {

    showEntryMessage(
      "Your name is too long.",
      "error"
    );

    return null;
  }

  return name;
}


