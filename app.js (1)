/* =========================================================
   LEAVE ROOM
========================================================= */

async function leaveRoom() {

  if (
    !supabaseClient ||
    !currentPlayer ||
    !currentRoom
  ) {

    clearSession();

    showPage(entryPage);

    return;
  }

  setButtonLoading(
    leaveRoomBtn,
    true
  );

  try {

    const playerId =
      currentPlayer.id;

    const roomCode =
      currentRoom.code;

    const {
      error: playerError
    } =
      await supabaseClient
        .from("players")
        .delete()
        .eq("id", playerId)
        .eq("room_code", roomCode);

    if (playerError) {
      throw playerError;
    }

    const remaining =
      await getPlayers(roomCode);

    if (remaining.length === 0) {

      await supabaseClient
        .from("rooms")
        .delete()
        .eq("code", roomCode);

    } else if (
      currentRoom.host_id === playerId
    ) {

      const newHost =
        remaining[0];

      const {
        error
      } =
        await supabaseClient
          .from("rooms")
          .update({
            host_id: newHost.id
          })
          .eq("code", roomCode);

      if (error) {
        throw error;
      }
    }

    unsubscribeRoom();

    clearSession();

    currentPlayer = null;

    currentRoom = null;

    showPage(entryPage);

    playerNameInput.value = "";

    roomCodeInput.value = "";

    showEntryMessage(
      "You left the room.",
      "success"
    );

    setSystemStatus(
      "Connection ready",
      "online"
    );

  } catch (error) {

    console.error(
      "Leave room failed:",
      error
    );

    showToast(
      readableDatabaseError(error),
      "error"
    );

  } finally {

    setButtonLoading(
      leaveRoomBtn,
      false
    );
  }
}


