let isHost = false;
let gameStarted = false;


/* =========================================================
   HELPERS
   ========================================================= */

const $ = id => document.getElementById(id);

function getEl(...ids) {
  for (const id of ids) {
    const el = $(id);
    if (el) return el;
  }
  return null;
}

function notify(message) {
  console.log("[MR REAPER]", message);

  const el = getEl(
    "statusMessage",
    "message",
    "notification",
    "errorMessage",
    "error"
  );

  if (el) {
    el.textContent = message;
    el.style.display = "block";
  }
}

function setConnection(text) {
  const el = getEl(
    "connectionStatus",
    "connection-status",
    "status",
    "reaperStatus"
  );

  if (el) el.textContent = text;
}


/* =========================================================
   SUPABASE
   ========================================================= */

function initSupabase() {
  if (!window.supabase) {
    notify("Supabase library failed to load.");
    return false;
  }

  try {
    supabaseClient =
      window.supabase.createClient(
        SUPABASE_URL,
        SUPABASE_KEY
      );

    setConnection("REAPER CONNECTION ONLINE");

    return true;
  } catch (err) {
    console.error(err);
    notify("Supabase initialization failed.");
    return false;
  }
}


/* =========================================================
   PLAYER ID
   ========================================================= */

function generatePlayerId() {
  return (
    "p_" +
    Date.now().toString(36) +
    "_" +
    Math.random()
      .toString(36)
      .substring(2, 10)
  );
}

function getPlayerId() {
  let id =
    sessionStorage.getItem(
      "mr_reaper_player_id"
    );

  if (!id) {
    id = generatePlayerId();

    sessionStorage.setItem(
      "mr_reaper_player_id",
      id
    );
  }

  return id;
}


/* =========================================================
   ROOM CODE
   ========================================================= */

function generateRoomCode() {
  const chars =
    "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";

  let code = "";

  for (let i = 0; i < 5; i++) {
    code += chars[
      Math.floor(
        Math.random() * chars.length
      )
    ];
  }

  return code;
}


/* =========================================================
   INPUTS
   ========================================================= */

function getName() {
  const input = getEl(
    "playerName",
    "name",
    "username",
    "player-name",
    "nickname"
  );

  if (!input) return "REAPER";

  return (
    input.value.trim() || "REAPER"
  ).substring(0, 20);
}

function getRoomCode() {
  const input = getEl(
    "roomCode",
    "room-code",
    "joinCode",
    "join-code",
    "code"
  );

  if (!input) return "";

  return input.value
    .trim()
    .toUpperCase()
    .replace(/[^A-Z0-9]/g, "")
    .substring(0, 5);
}


/* =========================================================
   SCREEN CONTROL
   ========================================================= */

