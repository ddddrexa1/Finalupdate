/* =========================================================
   CREATE UNIQUE ROOM CODE
   ========================================================= */

async function getUniqueRoomCode() {
  for (let attempt = 0; attempt < 20; attempt++) {
    const code =
      generateRoomCode();

    const {
      data,
      error
    } =
      await supabaseClient
        .from("rooms")
        .select("code")
        .eq("code", code)
        .maybeSingle();

    if (error) {
      throw error;
    }

    if (!data) {
      return code;
    }
  }

  throw new Error(
    "Unable to generate room code."
  );
}


/* =========================================================
   CREATE ROOM
   ========================================================= */

async function createRoom() {
  const playerId =
    getPlayerId();

  const playerName =
    getPlayerName();

  setStatus(
    "CREATING ROOM..."
  );

  try {
    /*
     * Generate room code.
     */

    const roomCode =
      await getUniqueRoomCode();

    /*
     * Create room.
     */

    const {
      data: room,
      error: roomError
    } =
      await supabaseClient
        .from("rooms")
        .insert({
          code: roomCode,
          host_id: playerId,
          state: "lobby",
          round: 0
        })
        .select()
        .single();

    if (roomError) {
      throw roomError;
    }

    /*
     * Add host/player.
     *
     * UPSERT is important because the same
     * browser can reload and keep its player ID.
     */

    const {
      error: playerError
    } =
      await supabaseClient
        .from("players")
        .upsert(
          {
            id: playerId,
            room_code: roomCode,
            name: playerName,
            status: "alive"
          },
          {
            onConflict: "id"
          }
        );

    if (playerError) {
      /*
       * Roll back room if player creation fails.
       */

      await supabaseClient
        .from("rooms")
        .delete()
        .eq("code", roomCode);

      throw playerError;
    }

    currentPlayer = {
      id: playerId,
      name: playerName
    };

    currentRoom =
      roomCode;

    roomData =
      room;

    isHost = true;
    gameStarted = false;

    sessionStorage.setItem(
      ROOM_KEY,
      roomCode
    );

    setStatus(
      "ROOM CREATED"
    );

    await openLobby();

  } catch (error) {
    console.error(
      "CREATE ROOM ERROR:",
      error
    );

    setStatus(
      "CREATE ROOM FAILED"
    );

    alert(
      error.message ||
      "Unable to create room."
    );
  }
}


/* =========================================================
   JOIN ROOM
   ========================================================= */

async function joinRoom() {
  const playerId =
    getPlayerId();

  const playerName =
    getPlayerName();

  let roomCode =
    getRoomCodeInput();

  if (!roomCode) {
    alert(
      "Enter a room code."
    );

    return;
  }

  if (roomCode.length !== 5) {
    alert(
      "Room code must be 5 characters."
    );

    return;
  }

  setStatus(
    "JOINING ROOM..."
  );

  try {
    /*
     * Find room.
     */

    const {
      data: room,
      error: roomError
    } =
      await supabaseClient
        .from("rooms")
        .select("*")
        .eq("code", roomCode)
        .maybeSingle();

    if (roomError) {
      throw roomError;
    }

    if (!room) {
      alert(
        "Room not found."
      );

      setStatus(
        "ROOM NOT FOUND"
      );

      return;
    }

    /*
     * Don't allow lobby joining after game begins.
     */

    if (room.state !== "lobby") {
      alert(
        "The game has already started."
      );

      setStatus(
        "GAME ALREADY STARTED"
      );

      return;
    }

    /*
     * Count players.
     */

    const {
      count,
      error: countError
    } =
      await supabaseClient
        .from("players")
        .select("*", {
          count: "exact",
          head: true
        })
        .eq(
          "room_code",
          roomCode
        );

    if (countError) {
      throw countError;
    }

    if (
      count >= MAX_PLAYERS
    ) {
      alert(
        "This room is full."
      );

      setStatus(
        "ROOM FULL"
      );

      return;
    }

    /*
     * Add player.
     */

    const {
      error: playerError
    } =
      await supabaseClient
        .from("players")
        .upsert(
          {
            id: playerId,
            room_code: roomCode,
            name: playerName,
            status: "alive"
          },
          {
            onConflict: "id"
          }
        );

    if (playerError) {
      throw playerError;
    }

    currentPlayer = {
      id: playerId,
      name: playerName
    };

    currentRoom =
      roomCode;

    roomData =
      room;

    isHost =
      room.host_id === playerId;

    gameStarted = false;

    sessionStorage.setItem(
      ROOM_KEY,
      roomCode
    );

    setStatus(
      "ROOM JOINED"
    );

    await openLobby();

  } catch (error) {
    console.error(
      "JOIN ROOM ERROR:",
      error
    );

    setStatus(
      "JOIN FAILED"
    );

    alert(
      error.message ||
      "Unable to join room."
    );
  }
}


