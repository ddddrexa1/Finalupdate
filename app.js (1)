    if (!room) {
      alert(
        "Room not found."
      );

      setStatus(
        "ROOM NOT FOUND"
      );

      return;
    }

    if (room.state !== "lobby") {
      alert(
        "The game has already started."
      );

      setStatus(
        "GAME ALREADY STARTED"
      );

      return;
    }

    const {
      count,
      error: countError
    } =
      await supabaseClient
        .from("players")
        .select("*", {
          count: "exact",
          head: true
        })
        .eq(
          "room_code",
          roomCode
        );

    if (countError) {
      throw countError;
    }

    if (count >= MAX_PLAYERS) {
      alert(
        "This room is full."
      );

      setStatus(
        "ROOM FULL"
      );

      return;
    }

    const {
      error: playerError
    } =
      await supabaseClient
        .from("players")
        .upsert(
          {
            id: playerId,
            room_code: roomCode,
            name: playerName,
            status: "alive"
          },
          {
            onConflict: "id"
          }
        );

    if (playerError) {
      throw playerError;
    }

    currentPlayer = {
      id: playerId,
      name: playerName
    };

    currentRoom =
      roomCode;

    roomData =
      room;

    isHost =
      room.host_id === playerId;

    gameStarted = false;

    sessionStorage.setItem(
      ROOM_KEY,
      roomCode
    );

    setStatus(
      "ROOM JOINED"
    );

    await openLobby();

  } catch (error) {
    console.error(
      "JOIN ROOM ERROR:",
      error
    );

    setStatus(
      "JOIN FAILED"
    );

    alert(
      error.message ||
      "Unable to join room."
    );
  }
}


/* =========================================
   OPEN LOBBY
   ========================================= */

async function openLobby() {
  hideElement(
    "loginScreen",
    "login",
    "homeScreen",
    "home",
    "startScreen"
  );

  showElement(
    "lobbyScreen",
    "lobby",
    "roomScreen"
  );

  setElementText(
    currentRoom,
    "roomCodeDisplay",
    "roomCodeText",
    "currentRoomCode",
    "room-code-display"
  );

  await subscribeToRoom();

  await refreshRoom();

  updateStartButton();
}


/* =========================================
   REFRESH ROOM
   ========================================= */

async function refreshRoom() {
  if (!currentRoom) {
    return;
  }

  try {
    const {
      data: room,
      error: roomError
    } =
      await supabaseClient
        .from("rooms")
        .select("*")
        .eq(
          "code",
          currentRoom
        )
        .maybeSingle();

    if (roomError) {
      throw roomError;
    }

    if (!room) {
      setStatus(
        "ROOM CLOSED"
      );

      await resetLocalState();

      return;
    }

    roomData =
      room;

    isHost =
      room.host_id ===
      getPlayerId();

    const {
      data: playerRows,
      error: playerError
    } =
      await supabaseClient
        .from("players")
        .select(
          "id, room_code, name, status, created_at"
        )
        .eq(
          "room_code",
          currentRoom
        )
        .order(
          "created_at",
          {
            ascending: true
          }
        );

    if (playerError) {
      throw playerError;
    }

    players =
      playerRows || [];

    renderPlayers();

    updateStartButton();

    if (
      room.state === "playing"
    ) {
      startGameScreen(room);
    }

  } catch (error) {
    console.error(
      "REFRESH ROOM ERROR:",
      error
    );
  }
}


/* =========================================
   RENDER PLAYERS
   ========================================= */

function renderPlayers() {
  setElementText(
    `${players.length}/${MAX_PLAYERS}`,
    "playerCount",
    "playersCount",
    "roomPlayerCount"
  );

  const list =
    getElement(
      "playerList",
      "playersList",
      "lobbyPlayers",
      "players"
    );

  if (!list) {
    return;
  }

  list.innerHTML = "";

  players.forEach(
    (player, index) => {
      const row =
        document.createElement(
          "div"
        );

      row.className =
        "player-row";

      if (
        player.id ===
        getPlayerId()
      ) {
        row.classList.add(
          "current-player"
        );
      }

      if (
        roomData &&
        player.id ===
        roomData.host_id
      ) {
        row.classList.add(
          "host-player"
        );
      }

      const number =
        document.createElement(
          "span"
        );

      number.className =
        "player-number";

      number.textContent =
        String(index + 1);

      const name =
        document.createElement(
          "span"
        );

      name.className =
        "player-name";

      name.textContent =
        player.name ||
        "Player";

      const badge =
        document.createElement(
          "span"
        );

      badge.className =
        "player-badge";

      badge.textContent =
        roomData &&
        player.id ===
        roomData.host_id
          ? "HOST"
          : "PLAYER";

      row.appendChild(
        number
      );

      row.appendChild(
        name
      );

      row.appendChild(
        badge
      );

      list.appendChild(
        row
      );
    }
  );
}


/* =========================================
   START BUTTON
   ========================================= */

function updateStartButton() {
  const button =
    getElement(
      "startGameBtn",
      "startGame",
      "start",
      "btnStart"
    );

  if (!button) {
    return;
  }

  button.style.display =
    isHost ? "" : "none";

  button.disabled =
    !isHost ||
    players.length < MIN_PLAYERS ||
    players.length > MAX_PLAYERS ||
    !roomData ||
    roomData.state !== "lobby";

  if (
    players.length <
    MIN_PLAYERS
  ) {
    button.textContent =
      "WAITING FOR PLAYERS";
  } else {
    button.textContent =
      "START GAME";
  }
}


/* =========================================
   START GAME
   ========================================= */

async function startGame() {
  if (!currentRoom) {
    return;
  }

  if (!isHost) {
    alert(
      "Only the host can start the game."
    );

    return;
  }

  const {
    data: freshPlayers,
    error
  } =
    await supabaseClient
      .from("players")
      .select("id")
      .eq(
        "room_code",
        currentRoom
      );

  if (error) {
    console.error(error);

    alert(
      "Could not check players."
    );

    return;
  }

  if (
    freshPlayers.length <
    MIN_PLAYERS
  ) {
    alert(
      "At least 2 players are required."
    );

    return;
  }

  if (
    freshPlayers.length >
    MAX_PLAYERS
  ) {
    alert(
      "Maximum 30 players allowed."
    );

    return;
  }

  setStatus(
    "STARTING GAME..."
  );

  try {
    const {
      data,
      error: updateError
    } =
      await supabaseClient
        .from("rooms")
        .update({
          state: "playing",
          round: 1
        })
        .eq(
          "code",
          currentRoom
        )
        .eq(
          "host_id",
          getPlayerId()
        )
        .select()
        .single();

    if (updateError) {
      throw updateError;
    }

    roomData =
      data;

    startGameScreen(
      data
    );

  } catch (error) {
    console.error(
      "START GAME ERROR:",
      error
    );

    setStatus(
      "GAME START FAILED"
    );

    alert(
      error.message ||
      "Unable to start game."
    );
  }
}


/* =========================================
   GAME SCREEN
   ========================================= */

function startGameScreen(room) {
  if (gameStarted) {
    return;
  }

  gameStarted = true;

  roomData =
    room;

  hideElement(
    "lobbyScreen",
    "lobby",
    "roomScreen"
  );

  showElement(
    "gameScreen",
    "game",
    "gameContainer"
  );

  setElementText(
    String(room.round || 1),
    "roundNumber",
    "currentRound",
    "gameRound"
  );

  setStatus(
    "ROUND " +
    (room.round || 1) +
    " — GAME STARTED"
  );

  if (
    typeof window.initializeGame ===
    "function"
  ) {
    window.initializeGame(
      currentRoom,
      currentPlayer,
      players
    );
  }

  if (
    typeof window.startReaperGame ===
    "function"
  ) {
    window.startReaperGame(
      currentRoom,
      currentPlayer,
      players
    );
  }
}


/* =========================================
   REALTIME ROOM
   ========================================= */

async function subscribeToRoom() {
  await unsubscribeFromRoom();

  if (!currentRoom) {
    return;
  }

  roomChannel =
    supabaseClient.channel(
      "reaper-room-" +
      currentRoom
    );

  roomChannel
    .on(
      "postgres_changes",
      {
        event: "*",
        schema: "public",
        table: "rooms",
        filter:
          "code=eq." +
          currentRoom
      },
      payload => {
        console.log(
          "ROOM UPDATE:",
          payload
        );

        refreshRoom();
      }
    )
    .on(
      "postgres_changes",
      {
        event: "*",
        schema: "public",
        table: "players",
        filter:
          "room_code=eq." +
          currentRoom
      },
      payload => {
        console.log(
          "PLAYER UPDATE:",
          payload
        );

        refreshRoom();
      }
    )
    .subscribe(
      status => {
        console.log(
          "REALTIME STATUS:",
          status
        );
      }
    );
}


/* =========================================
   UNSUBSCRIBE
   ========================================= */

async function unsubscribeFromRoom() {
  if (!roomChannel) {
    return;
  }

  try {
    await supabaseClient
      .removeChannel(
        roomChannel
      );
  } catch (error) {
    console.warn(
      "Realtime cleanup error:",
      error
    );
  }

  roomChannel =
    null;
}


/* =========================================
   LEAVING ROOM
   ========================================= */

async function leaveRoom() {
  if (!currentRoom) {
    return;
  }

  const roomCode =
    currentRoom;

  const playerId =
    getPlayerId();

  setStatus(
    "LEAVING ROOM..."
  );

  try {
    /*
     * Get current room before removing player.
     */

    const {
      data: room
    } =
      await supabaseClient
        .from("rooms")
        .select("*")
        .eq(
          "code",
          roomCode
        )
        .maybeSingle();

    /*
     * Remove this player.
     */

    const {
      error: deleteError
    } =
      await supabaseClient
        .from("players")
        .delete()
        .eq(
          "id",
          playerId
        )
        .eq(
          "room_code",
          roomCode
        );

    if (deleteError) {
      console.error(
        "PLAYER DELETE ERROR:",
        deleteError
      );
    }

    /*
     * Get remaining players.
     */

    const {
      data: remaining,
      error: remainingError
    } =
      await supabaseClient
        .from("players")
        .select(
          "id, created_at"
        )
        .eq(
          "room_code",
          roomCode
        )
        .order(
          "created_at",
          {
            ascending: true
          }
        );

    if (remainingError) {
      throw remainingError;
    }

    /*
     * Nobody left.
     * Delete room.
     */

    if (
      !remaining ||
      remaining.length === 0
    ) {
      await supabaseClient
        .from("rooms")
        .delete()
        .eq(
          "code",
          roomCode
        );
    }

    /*
     * Host left.
     * Give host to next player.
     */

    else if (
      room &&
      room.host_id === playerId
    ) {
      await supabaseClient
        .from("rooms")
        .update({
          host_id:
            remaining[0].id
        })
        .eq(
          "code",
          roomCode
        );
    }

  } catch (error) {
    console.error(
      "LEAVE ROOM ERROR:",
      error
    );
  }

  await resetLocalState();

  showElement(
    "loginScreen",
    "login",
    "homeScreen",
    "home",
    "startScreen"
  );

  hideElement(
    "lobbyScreen",
    "lobby",
    "roomScreen",
    "gameScreen",
    "game",
    "gameContainer"
  );

  setStatus(
    "REAPER READY"
  );
}


/* =========================================
   RESET LOCAL STATE
   ========================================= */

async function resetLocalState() {
  await unsubscribeFromRoom();

  currentPlayer = null;
  currentRoom = null;
  roomData = null;
  players = [];

  isHost = false;
  gameStarted = false;

  sessionStorage.removeItem(
    ROOM_KEY
  );
}
}
